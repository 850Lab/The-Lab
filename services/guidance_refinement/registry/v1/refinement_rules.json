    {
      "rule_id": "pl_cb_late_elevate",
      "pivot_types": ["pivot_cross_bureau_late_payment"],
      "guidance_kind": "cross_bureau_tradeline",
      "link_kind": "elevate",
      "priority_delta": 8,
      "emphasis_level": "primary",
      "max_accumulated_delta": 24
    },
    {
      "rule_id": "pl_cfpb_deemphasize",
      "pivot_types": ["pivot_cfpb_unresolved_facts"],
      "guidance_kind": "low_stakes_hygiene",
      "link_kind": "deemphasize",
      "priority_delta": 15,
      "emphasis_level": "secondary",
      "max_accumulated_delta": 30
    }
  ],
  "pivot_priority_total_cap": 32,
  "scope_focus_rules": [
    {
      "rule_id": "sf_bureau_detail",
      "when_step_scope_mode": "bureau_detail",
