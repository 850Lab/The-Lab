      "applies_to_scope_types": ["bureau"],
      "mismatch_visibility": "hidden",
      "reason_code": "BUREAU_FOCUS_MISMATCH"
    }
  ],
  "pivot_suppress_rules": [
    {
      "rule_id": "ps_cfpb_vs_hygiene",
