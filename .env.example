# Permanent local configuration (copy to `.env` in this same folder — next to `database.py`)
# `.env` is gitignored. The API loads it automatically on startup.
#
# Supabase DB: Dashboard → Project Settings → Database → Connection string (URI).
# Use `?sslmode=require` at the end. If your password has `$`, use `%24` instead of `$`.
#
# Resend email: https://resend.com/api-keys — use `onboarding@resend.dev` for quick tests.

DATABASE_URL=postgresql://postgres:REPLACE_DB_PASSWORD@db.REPLACE_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Deployed production (REPLIT_DEPLOYMENT=1 or ENVIRONMENT=production): DATABASE_URL is required; DB_BACKEND=sqlite is rejected (one DB for auth, org, reports, workflow).
# Local workflow-in-sqlite-only experiments: DB_BACKEND=sqlite + WORKFLOW_SQLITE_PATH (never use in production).
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=onboarding@resend.dev
# Optional (local debug): include Resend error in 503 message for /api/auth/resend-verification
# WORKFLOW_DEV_EMAIL_HINTS=1
# Dev-only: after reminder email failure, mark sent as channel "stub". Ignored in production (REPLIT_DEPLOYMENT=1 or ENVIRONMENT=production).
# WORKFLOW_REMINDER_FALLBACK_STUB=1

# Optional: when running Streamlit, show a caption that points contributors to React+API as authoritative
# (see docs/STREAMLIT_RETIREMENT.md)
# STREAMLIT_LEGACY_REFERENCE_BANNER=1

# Streamlit is legacy; customer mutations default OFF in production (REPLIT_DEPLOYMENT=1 or ENVIRONMENT=production).
# STREAMLIT_ALLOW_CUSTOMER_MUTATIONS=1 — escape hatch to re-enable Streamlit hooks + report saves + workflow shell.
# STREAMLIT_CUSTOMER_READ_ONLY=1 — force read-only in any environment (non-admin: redirect shell; streamlit save_report + streamlit hooks no-op).
# STREAMLIT_WORKFLOW_MUTATIONS_DISABLED=1 — legacy alias: same hook blocking as read-only policy (see services/workflow/hooks.py).

# --- Public React demo (GET/POST /api/public/demo/*) --------------------------------------------
# Home page runs the REAL parser + workflow on fixture PDFs under samples/ (not a fake UI).
#
# Default: no PUBLIC_DEMO_USER_ID needed — the API auto-creates a synthetic user
# (850lab.public.demo@internal.invalid) on first demo run and grants starter entitlements.
# Operators can pre-create/repair that row explicitly:
#   python scripts/ensure_public_demo_test_account.py
# Optional top-up credits: add --top-up
#
# NEVER set PUBLIC_DEMO_USER_ID to a real customer's users.id — the demo account accumulates
# reports; historically the UI could surface any data on that user row. The API now scopes each
# demo response to the fixture run and blocks non-synthetic emails unless you opt out below.
#
# Optional: PUBLIC_DEMO_USER_ID=<users.id> only for a dedicated synthetic row (email must be
# 850lab.public.demo@internal.invalid or end in @internal.invalid), or set:
#   PUBLIC_DEMO_ALLOW_NON_SYNTHETIC_USER=1
# …only if you knowingly accept privacy/compliance risk (not recommended).
#
# Optional: python scripts/bootstrap_public_demo_user.py <id> for extra letter/mail credits on that id.
#
# Production-like (REPLIT_DEPLOYMENT=1 or ENVIRONMENT=production): set
#   PUBLIC_DEMO_ENABLED=1
# Railway: add PUBLIC_DEMO_ENABLED=1 as a variable on the API/workflow service (not the web
# build only) so GET /api/public/demo/scenarios succeeds; check /api/system/customer-web-status.
#
# PUBLIC_DEMO_USER_ID=123
# PUBLIC_DEMO_ENABLED=1
# Public demo POST always masks letter bodies, review-claim blobs, and file names before JSON
# is returned (scenario copy from config/public_demo_scenarios.json merged with safe defaults).
# Local debugging only — never enable on a public URL:
# PUBLIC_DEMO_SKIP_VISITOR_MASK=1
#
# Optional: max unauthenticated demo runs per client IP per minute (default 12)
# PUBLIC_DEMO_RATE_PER_MINUTE=12
# Optional: require this header from the browser when set (set VITE_PUBLIC_DEMO_SECRET to match in web/.env.local)
# PUBLIC_DEMO_SECRET=

# Optional: team inbox for instant ping when someone submits the /demo lead form (Resend)
# DEMO_LEADS_NOTIFY_EMAIL=you@yourcompany.com

# Optional: max demo lead form posts per client IP per minute (default 8)
# PUBLIC_DEMO_LEAD_RATE_PER_MINUTE=8

# --- Web (Vite dev): proxy for /workflow-api (create web/.env.local in the web/ folder) ---
# Default target is http://127.0.0.1:5000. If uvicorn uses another port, set e.g.:
# WORKFLOW_API_PROXY_TARGET=http://127.0.0.1:8000
# From repo root: npm run workflow-api  (API on :5000) in one terminal, npm run dev in another.
# Or from web/: npm run workflow-api && npm run dev in two terminals.
#
# Report PDF upload (workflow API): defaults allow one file up to 200 MB (server splits by page).
# Reverse proxies must allow that body size or uploads 413 before Python runs. Optional:
#   MAX_SINGLE_REPORT_UPLOAD_MB=200
#   MAX_MERGED_REPORT_MB=250
# Multi-file uploads: each part still capped at 25 MB (merged total capped by MAX_MERGED_REPORT_MB).
#
# Upload reliability (correctness under large files / slow networks):
# - The API streams parts to disk with fsync + SHA-256 before enqueue (see services/report_upload_staging.py).
# - "Failed to fetch" before any JSON response is usually proxy/LB idle timeout, body limit, or TCP drop —
#   tune the reverse proxy (e.g. nginx client_max_body_size, proxy_read_timeout / proxy_send_timeout) and
#   your host’s HTTP timeout to exceed worst-case upload time. No env var in this app overrides those limits.
# --- Direct-to-object-storage (optional; coexists with legacy POST multipart upload) ---
# S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, etc.). Session + presigned PUT: services/report_upload_session_service.py
# REPORT_UPLOAD_S3_BUCKET=your-bucket
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# Optional: R2 / custom endpoint (otherwise standard AWS S3)
# REPORT_UPLOAD_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# REPORT_UPLOAD_S3_REGION=auto
# Session row TTL and presigned URL lifetime (seconds)
# REPORT_UPLOAD_SESSION_TTL_SECONDS=3600
# REPORT_UPLOAD_PRESIGN_EXPIRES_SECONDS=3600

# --- Web (Vite): optional support link when demo is unavailable ---
# VITE_PUBLIC_SUPPORT_EMAIL=hello@yourcompany.com
# VITE_PUBLIC_DEMO_SECRET= (must match PUBLIC_DEMO_SECRET if you lock down demo)
# Optional: hide the collapsed "For site operators" checklist on /demo (default: shown)
# VITE_HIDE_DEMO_OPS_HINTS=1

# --- Web (Vite): ephemeral GTM preview console at /launch-preview (separate from Mission Control)
# Put these in web/.env.local (Vite reads env from the web/ folder when you `npm run build` there).
# `npm run dev` enables the full console automatically; production `web/dist` needs the flag baked in:
# VITE_LAUNCH_PREVIEW_ENABLED=1
# Optional passphrase (sessionStorage gate). Leave unset locally for no gate.
# VITE_LAUNCH_PREVIEW_KEY=your-shared-passphrase
# Optional: show footer link on login/signup in production (without enabling full hub UI in bundle).
# VITE_SHOW_PAGE_HUB_LINK=1

# --- Railway / Docker (workflow API) --------------------------------------------------------
# The repo includes Dockerfile (Poppler + Tesseract + pip install -r requirements.txt) and
# railway.toml so Railway can build and run without extra repo changes.
# Container start (Railway Dockerfile / railway.toml): uvicorn on 0.0.0.0:8000.
#
# Set in Railway → Variables (or your host’s secret store), at minimum for production-like mode:
#   DATABASE_URL=postgresql://...supabase...?sslmode=require
#   ENVIRONMENT=production
#   RESEND_API_KEY=...
#   RESEND_FROM_EMAIL=...
# Optional but common: WORKFLOW_INTERNAL_API_SECRET, WORKFLOW_ADMIN_API_SECRET, STRIPE_SECRET_KEY, etc.
# Upload limits (optional): MAX_SINGLE_REPORT_UPLOAD_MB=200, MAX_MERGED_REPORT_MB=250
# If large PDFs fail with "Failed to fetch" or 502 mid-upload, increase platform/proxy timeouts and body limits
# (see "Upload reliability" under Report PDF upload above). Railway: check service HTTP timeout vs upload duration.
#
# Vercel (or other static host): bake at build time:
#   VITE_WORKFLOW_API_URL=https://YOUR-RAILWAY-SERVICE.up.railway.app
# (no trailing slash; see web/src/lib/apiBase.ts)
#
# Lean API-only dependency set (smaller image, no Streamlit/Playwright): see requirements-workflow-server.txt
# — only switch the Dockerfile pip line after verifying your feature set does not need omitted packages.

# --- Workflow: all linear phases (local / test / staging / Railway) -----------------------------
# Step order: upload → parse_analyze → review_claims → select_disputes → payment → letter_generation
#   → proof_attachment → mail → track  (see services/workflow/registry.py)
#
# Background jobs (parse, etc.): default WORKFLOW_JOB_WORKER_ENABLED=1 embeds the worker in the API process.
# Set WORKFLOW_JOB_WORKER_ENABLED=0 only if you run a dedicated worker or in tests that mock jobs.
#
# Stripe (payment + letter entitlements): set both keys from the same Stripe mode (test vs live).
#   STRIPE_SECRET_KEY=sk_test_... or sk_live_...
#   STRIPE_PUBLISHABLE_KEY=pk_test_... or pk_live_...
# Stripe Checkout return URLs need the customer app origin (must match how users open the React app):
#   WORKFLOW_CUSTOMER_APP_ORIGIN=https://app.example.com
#   # or PUBLIC_APP_ORIGIN (alias)
# Webhook verification (Streamlit/app webhook): STRIPE_WEBHOOK_SECRET=whsec_...
#
# Lob (certified mail): LOB_API_KEY=test_... or live_...
# Staging/dev with a test key: leave REQUIRE_LOB_LIVE_FOR_CUSTOMER_SEND unset or 0 — otherwise customer
# mail is blocked when the key is still test_* (see lob_client.customer_mail_send_blocked_reason).
# Production live mail: use a live Lob key; you may set REQUIRE_LOB_LIVE_FOR_CUSTOMER_SEND=1 to block test keys.
#
# Full phase-by-phase checklist: docs/WORKFLOW_PHASES_ENV.md
