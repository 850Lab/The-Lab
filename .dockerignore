# Keep API image small and builds fast (exclude SPA toolchain and local junk).
.git
.gitignore
.cursor
**/__pycache__
**/*.pyc
.venv
venv
.env
.env.*
!.env.example
node_modules
# Web: source is needed for Docker multi-stage build; omit deps and host dist (built in image).
web/node_modules
web/dist
playwright-report
test-results
.pytest_cache
*.sqlite
lab_truth/*.sqlite
lab_truth/*.sqlite-journal
lab_truth/*.sqlite-wal
lab_truth/*.sqlite-shm
