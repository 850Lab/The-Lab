# Copy to .env.local for local dev (optional — vite.config.ts defaults to port 8000).
# Repo root: python -m uvicorn api.workflow_app:app --host 127.0.0.1 --port 8000
WORKFLOW_API_PROXY_TARGET=http://127.0.0.1:8000
# Or bypass the proxy and call the API directly from the browser:
# VITE_WORKFLOW_API_URL=http://127.0.0.1:8000
#
# Staging / production static build: bake the workflow API origin at build time (no trailing slash):
# VITE_WORKFLOW_API_URL=https://your-service.up.railway.app
# Server must set WORKFLOW_CUSTOMER_APP_ORIGIN to this Vite app's public URL for Stripe return URLs.
#
# Phase-by-phase server env (Stripe, Lob, worker, DB): see repo docs/WORKFLOW_PHASES_ENV.md
# Single-file presigned S3/R2 upload (browser PUT). Set to 0 for multipart-only (same-origin API — recommended for Railway Dockerfile build; avoids S3 CORS/storage misconfig).
# VITE_USE_DIRECT_REPORT_UPLOAD=0
#
# Waitlist-only public shell (narrow signed-out paths, home = waitlist landing). Omit for guided product home.
# Railway Docker build: set build-time variable VITE_WAITLIST_MODE=true only if you want waitlist mode.
# VITE_WAITLIST_MODE=true
